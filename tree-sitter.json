{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cm",
      "camelcase": "Cm",
      "title": "C(m)",
      "scope": "source.cm",
      "file-types": [
        "cm"
      ],
      "injection-regex": "^cm$",
      "class-name": "TreeSitterCm",
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "the C(m) programming language",
    "authors": [
      {
        "name": "Boris Vassilev",
        "email": "boris.n.vassilev@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/BorisVassilev1/tree-sitter-cm"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
